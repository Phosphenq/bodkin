# --- network -----------------------------------------------------------------
# Leave RPC_URL empty to use the built-in public pair: publicnode for state reads (fast, generous, no eth_getLogs)
# and the official Robinhood RPC for logs (strict limits). Or give your own, comma-separated, preferred first;
# add #nologs after an endpoint that refuses eth_getLogs. One private provider (Alchemy, Chainstack) can carry everything.
RPC_URL=
# Detection by subscription. Empty = publicnode's free websocket (default). "off" = 300 ms HTTP polling.
# Your own, e.g. Alchemy: wss://robinhood-mainnet.g.alchemy.com/v2/KEY
RPC_WS_URL=
# Poll interval for HTTP detection when the websocket is off, ms (chain blocks every ~100 ms).
POLL_MS=300

# --- wallet ------------------------------------------------------------------
# Only needed for `snipe --live`, `buy`, `sell`. Never commit this file.
PRIVATE_KEY=

# --- sniper defaults (override per run with flags) ---------------------------
SNIPE_ETH=0.01
SNIPE_SLIPPAGE_BPS=300
# Do not buy while the opening snipe tax is above this (99% at t=0, ~0 after 3 s).
SNIPE_MAX_TAX_BPS=300
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=35
TRAILING_PCT=25
MAX_HOLD_MIN=45

# --- alerts (optional) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- board -------------------------------------------------------------------
BOARD_PORT=4663

# public RPC burst limit: requests in flight and minimum spacing between them (raise on a private RPC)
RPC_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400
